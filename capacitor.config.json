{
  "appId": "com.iveey.bookbox",
  "appName": "BookBox",
  "webDir": "dist",
  "backgroundColor": "#0F0B1D",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 400,
      "launchAutoHide": true,
      "backgroundColor": "#0F0B1D",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#EFE9E6"
    }
  }
}
